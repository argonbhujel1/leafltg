SECRET_KEY=generate-a-long-random-string-here
DATABASE_URL=sqlite:///instance/leaf_letang.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/leaf_letang

ADMIN_USERNAME=admin
# Generate with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-secure-password'))"
ADMIN_PASSWORD_HASH=

# Optional company contact (leave blank if not public)
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_FACEBOOK=
COMPANY_INSTAGRAM=
COMPANY_YOUTUBE=
COMPANY_TIKTOK=
COMPANY_WEBSITE=https://leafletang.com

# Optional mail (not required for basic contact form storage)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

FLASK_ENV=development
